# ---- 密钥：绝不入库 ----
secrets/
*.key
*.pem
.env
.env.*
**/config/*.live.yaml
**/config/*.paper.yaml
!**/config/*.example.yaml

# ---- 第三方参考代码：浅克隆的开源仓库，只读参考，不入库 ----
/vendor/

# ---- 数据与运行产物 ----
# 一律根锚定（前导 /）。未锚定的 `data/` 会匹配任意层级的同名目录，
# 曾因此把 `docs/data/`（数据说明与重建 manifest，必须入库）一并排除。
/data/
/logs/
/reports/
/backtest/results/
*.parquet
*.csv.gz

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# ---- 系统 ----
.DS_Store
.claude/worktrees/
